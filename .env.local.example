# Copy to `.env` and fill in. (`.env` is used so both Next.js and the Prisma CLI
# read the same file.)

# Active tenant selector. Chooses which config/tenants/<TENANT>.config.ts is
# loaded for this deployment. Defaults to "imus" when unset.
TENANT=imus

# Prisma datasource. SQLite by default (zero infra). To use Postgres, change
# prisma/schema.prisma `provider` to "postgresql" and set a Postgres URL here.
DATABASE_URL="file:./dev.db"

# Auth.js (NextAuth v5) JWT signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me"
